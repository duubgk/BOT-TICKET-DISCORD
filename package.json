{
  "name": "bot-tickets-loja",
  "version": "1.0.0",
  "description": "Bot de Discord para tickets de uma loja: painel de atendimento, Pix com QR Code, calculadora de preços, entregas, avaliações e transcript",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@constatic/base": "latest",
    "@magicyan/discord": "1.6.3",
    "chalk": "5.6.2",
    "discord.js": "14.25.1",
    "qrcode": "^1.5.4",
    "rou3": "0.7.10",
    "zod": "4.1.11"
  },
  "imports": {
    "#env": "./src/env.js",
    "#base": "./src/discord/index.js",
    "#functions": "./src/functions/index.js",
    "#server": "./src/server/index.js",
    "#shared/*": "./src/shared/*"
  }
}
